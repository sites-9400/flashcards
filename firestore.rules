rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(deckData) {
      return request.auth != null && request.auth.uid == deckData.ownerUid;
    }
    function deckData(deckId) {
      return get(/databases/$(database)/documents/decks/$(deckId)).data;
    }

    match /decks/{deckId} {
      allow read: if resource.data.visibility == 'published' || isOwner(resource.data);
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data);

      match /cards/{cardId} {
        allow read: if deckData(deckId).visibility == 'published' || isOwner(deckData(deckId));
        allow create, update, delete: if isOwner(deckData(deckId));
      }
    }

    // Deny-all for the AI grading daily-cap counter: this doc is written only
    // by the gradeAnswer function via the Admin SDK, which bypasses rules
    // entirely. Clients must never be able to read or write it, since a
    // client-writable counter would let an authed user reset their own daily
    // cap. This match must come before, and be excluded from, the catch-all
    // below (a matching allow anywhere grants access regardless of order).
    match /users/{uid}/gradingUsage/{document=**} {
      allow read, write: if false;
    }

    // The user's own top-level profile doc (users/{uid} itself, no
    // subcollection segment). Kept separate from the subcollection catch-all
    // below because the collection-name exclusion there only applies to
    // documents inside a named subcollection.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Every subcollection under users/{uid} except gradingUsage (denied
    // above). The {collection} segment is bound to a single path element, so
    // it can be compared directly with != instead of indexing into a
    // document-path list; that keeps this rule evaluable at list time, unlike
    // the previous document.size()/document[0] form which the emulator
    // rejects for list queries (getDocs) even though it evaluates fine for
    // single-document get()s.
    match /users/{uid}/{collection}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && collection != 'gradingUsage';
    }
  }
}
