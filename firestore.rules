rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(deckData) {
      return request.auth != null && request.auth.uid == deckData.ownerUid;
    }
    function deckData(deckId) {
      return get(/databases/$(database)/documents/decks/$(deckId)).data;
    }

    match /decks/{deckId} {
      allow read: if resource.data.visibility == 'published' || isOwner(resource.data);
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data);

      match /cards/{cardId} {
        allow read: if deckData(deckId).visibility == 'published' || isOwner(deckData(deckId));
        allow create, update, delete: if isOwner(deckData(deckId));
      }
    }

    // Deny-all for the AI grading daily-cap counter: this doc is written only
    // by the gradeAnswer function via the Admin SDK, which bypasses rules
    // entirely. Clients must never be able to read or write it, since a
    // client-writable counter would let an authed user reset their own daily
    // cap. This match must come before, and be excluded from, the catch-all
    // below (a matching allow anywhere grants access regardless of order).
    match /users/{uid}/gradingUsage/{document=**} {
      allow read, write: if false;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && !(document.size() > 0 && document[0] == 'gradingUsage');
    }
  }
}
